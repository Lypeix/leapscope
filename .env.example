POSTGRES_DB=leapscope
POSTGRES_USER=leapscope
POSTGRES_PASSWORD=secret

# Generate locally with: python -c "import secrets; print(secrets.token_hex(32))"
LEAPSCOPE_JWT_SECRET_KEY=secret
LEAPSCOPE_ACCESS_TOKEN_EXPIRE_MINUTES=30

LEAPSCOPE_APP_NAME=LeapScope API
LEAPSCOPE_ENVIRONMENT=development
LEAPSCOPE_DEBUG=false
LEAPSCOPE_DATABASE_URL=postgresql+psycopg://leapscope:password_placeholder@localhost:5432/leapscope

